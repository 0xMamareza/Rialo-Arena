{
  "name": "rialo-arena",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose --env-file .env.local up -d --wait postgres",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "TMPDIR=/tmp tsx scripts/seed-questions.ts",
    "db:verify": "TMPDIR=/tmp tsx scripts/verify-database.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "maintenance": "TMPDIR=/tmp NODE_OPTIONS=--conditions=react-server tsx scripts/run-maintenance.ts",
    "quiz:validate": "TMPDIR=/tmp tsx scripts/validate-question-bank.ts",
    "quiz:engine:verify": "TMPDIR=/tmp NODE_OPTIONS=--conditions=react-server tsx scripts/verify-quiz-engine.ts",
    "quiz:api:verify": "TMPDIR=/tmp NODE_OPTIONS=--conditions=react-server tsx scripts/verify-quiz-api.ts",
    "quiz:start:verify": "TMPDIR=/tmp NODE_OPTIONS=--conditions=react-server tsx scripts/verify-quiz-start.ts",
    "leaderboard:verify": "TMPDIR=/tmp NODE_OPTIONS=--conditions=react-server tsx scripts/verify-leaderboard.ts",
    "identity:verify": "TMPDIR=/tmp NODE_OPTIONS=--conditions=react-server tsx scripts/verify-identity.ts",
    "maintenance:verify": "TMPDIR=/tmp NODE_OPTIONS=--conditions=react-server tsx scripts/verify-rate-limit-maintenance.ts",
    "production:verify": "TMPDIR=/tmp NODE_OPTIONS=--conditions=react-server tsx scripts/verify-production-hardening.ts",
    "db:fresh:verify": "TMPDIR=/tmp tsx scripts/verify-fresh-database.ts",
    "build:verify": "TMPDIR=/tmp tsx scripts/verify-production-build.ts",
    "i18n:verify": "node --conditions=react-server --import tsx scripts/verify-i18n.ts && node --import tsx scripts/verify-i18n-catalogs.ts && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-learn-i18n.ts && node --import tsx scripts/verify-localized-arena-share.ts && node scripts/verify-localized-result-card.cjs && node scripts/verify-localized-quiz-presentation.cjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "next": "16.3.0",
    "ogl": "^1.0.11",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
